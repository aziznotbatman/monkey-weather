# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Your AI provider's secret key (server-side only). Leave empty to run on the built-in rule engine.
# Default provider is Google Gemini (free key at https://aistudio.google.com).
AI_API_KEY=

# Optional: switch provider. Any OpenAI-compatible endpoint with JSON-schema output works.
# Empty = Gemini (https://generativelanguage.googleapis.com/v1beta/openai/).
# Examples: https://api.openai.com/v1 · https://api.groq.com/openai/v1
AI_BASE_URL=

# Optional: model id at that provider. Empty = gemini-3.5-flash-lite.
AI_MODEL=

# Optional: none | minimal | low | medium | high | off (don't send). Empty = low.
AI_REASONING_EFFORT=

# Optional: link to your portfolio / case study, shown in the footer. Hidden if empty.
NEXT_PUBLIC_PORTFOLIO_URL=
