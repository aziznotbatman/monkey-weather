# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Your OpenAI secret key (server-side only). Leave empty to run on the built-in rule engine.
OPENAI_API_KEY=

# Optional: which OpenAI model to use. Defaults to gpt-6-luna if empty.
OPENAI_MODEL=

# Optional: link to your portfolio / case study, shown in the footer. Hidden if empty.
NEXT_PUBLIC_PORTFOLIO_URL=
